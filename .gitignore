*.jks
*.keystore

# iOS（本方案不出 iOS，但 flutter create 会生成，避免误提）
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/

# IDE / 编辑器
.idea/
*.iml
.vscode/
*.swp

# 系统
.DS_Store

# 环境与本地配置（AI key 等一律不入仓）
.env
.env.*
!.env.example
