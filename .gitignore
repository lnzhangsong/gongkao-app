# Flutter / Dart 构建产物
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.lock.bak

# Android 工程内的构建产物（android/ 目录本身保留，只忽略其中的产物）
android/.gradle/
android/captures/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
